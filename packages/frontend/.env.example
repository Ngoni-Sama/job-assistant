# Copy to .env.local. URL of the deployed (or local) backend Worker.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Google sign-in (Auth.js). Optional — the app works signed-out as "demo".
# AUTH_SECRET: generate with `npx auth secret` (or openssl rand -base64 32).
# AUTH_GOOGLE_ID / _SECRET: from Google Cloud Console → Credentials → OAuth client.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
