# ─────────────────────────────────────────────────────────────────────────────
# VacancyPal frontend env. Copy to:
#   .env.local       → local dev
#   .env.production  → nivacity (or set these in the cPanel Node.js App UI)
# NEVER commit the filled-in copies — this repo is public.
# ─────────────────────────────────────────────────────────────────────────────

# Backend Worker URL. Dev/test = job-assistant worker; prod = vacancypal-api worker.
# NOTE: baked in at BUILD time — build with the prod value for nivacity.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Public URL of THIS site (used for Pesepay return/callback URLs + Auth.js).
# Prod: https://vacancypal.co.zw
APP_URL=
AUTH_URL=

# Google sign-in (Auth.js).
# AUTH_SECRET: `npx auth secret` (or openssl rand -base64 32).
# Add <APP_URL>/api/auth/callback/google as an authorised redirect URI in Google Console.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Pesepay (Visa / Mastercard / EcoCash / OneMoney). From the Pesepay dashboard →
# your application ("vacanypal"). Encryption key must be exactly 32 characters.
PESEPAY_INTEGRATION_KEY=
PESEPAY_ENCRYPTION_KEY=

# Shared secret between this app and the Worker's /api/internal/* endpoints.
# Must equal the Worker's INTERNAL_SECRET (`wrangler secret put INTERNAL_SECRET`).
# Generate: openssl rand -hex 32
WORKER_INTERNAL_SECRET=
